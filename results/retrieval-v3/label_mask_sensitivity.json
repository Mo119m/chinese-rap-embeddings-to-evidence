  "design": {
    "arms": {
      "baseline": "the published configuration; reproduction check",
      "drop_near_identical_rival_queries": "queries with a chunk whose nearest other-label chunk exceeds cosine 0.99 dropped as queries, profiles unchanged; rival_anywhere is the arm as specified (the audit's definition); rival_outside_leakage_group is a companion that excludes the query's own group",
      "exclude_collaboration_titles": "songs with a collaboration mark in the title (training_data_audit_v3.FEAT on the private song_title column) removed as queries and profile members; groups rebuilt on the remaining songs; spaces refitted; labels re-checked",
      "leakage_threshold": "groups rebuilt at trigram Jaccard (0.7, 0.9) instead of 0.8; weights, scoring and bootstrap follow",
      "mask_all_labels": "every label string of the corpus removed from every chunk with train_identity_encoder_v3.mask_label, longest first, before fitting the word and character spaces; length rule re-applied; baseline groups kept; the semantic column needs the masked chunks embedded by --stage embed"
    },
    "bootstrap": "identity_spaces_v2.paired_group_bootstrap: 2000 replicates, seed 20260825, the arm's leakage groups resampled with replacement, each (group, label) component weighted one",
    "checks": "baseline reproduces the published MRR in every space (gap <= 0.002) and the pinned literals equal three_spaces.json; the population rule rebuilds the protocol's query set; dense scores identical across the two scorer calls (gap <= 1e-06); collaboration and self-mention counts compared with the audit; masked semantic column used only under a contract naming the current masked-text digest with median unmasked-chunk cosine >= 0.999",
    "estimands": "mrr = plain mean over the arm's queries (the published estimand); mrr_component_weighted = the bootstrap's per-(group, label)-weighted estimand; contrasts are on the weighted estimand",
    "population_rule": "a label needs 5 songs and 2 leakage groups in the arm",
    "protocol": "one document and one centroid per song; label profile = leave-group-out weighted sum; cosine rank of the true label; build_chinese_rap_downstream_retrieval_v1.score_leave_group_out and rank_system; a sparse row without features takes the worst rank",
    "reading_rule": "the ordering words > characters > semantic is robust to the arm if every pairwise contrast (words - characters, characters - semantic, words - semantic) keeps its sign (positive, as at baseline) with its interval clear of zero; otherwise not robust and the failing contrast is named; with the semantic column pending the arm reads partial on words - characters alone",
    "spaces": {
      "characters": "character 2-5-gram TF-IDF",
      "semantic": "BGE-M3 song centroids (recorded v3 chunk run)",
      "words": "jieba word 1-2-gram TF-IDF"
    }
  },
  "minutes": 6.3,
  "privacy": "aggregate only; the masked chunk table and its vectors are private",
